# PromptWizard provider keys. Copy to .env and fill in only what you use.
# Only free tiers are targeted. Keys are read from the environment and are never
# written into the repository or printed by the CLI.

# Google Gemini (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (free tier) - https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter, use model ids with the ":free" suffix - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any other OpenAI-compatible free tier (see README "Adding a free tier"):
# OPENAI_API_KEY=
# CEREBRAS_API_KEY=

# Optional overrides
# PROMPTWIZARD_HOME=~/.promptwizard
# PROMPTWIZARD_LANG=ru
# PROMPTWIZARD_PROVIDER=ollama
# PROMPTWIZARD_MODEL=llama3.2
# PROMPTWIZARD_TEMPERATURE=0.3
# PROMPTWIZARD_MAX_QUESTIONS=6
# OLLAMA_HOST=http://localhost:11434
